---
import { siteConfig, type Locale } from "../config/site";
import "../styles/global.css";

interface Props {
	lang?: Locale;
}

const { lang = siteConfig.defaultLocale } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href={siteConfig.assets.favicon} />
		<meta name="description" content={siteConfig.seo.description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{siteConfig.seo.title}</title>
	</head>
	<body
		class="bg-[#f3faef] text-text font-sans antialiased relative min-h-screen"
	>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		font-family: "Inter", sans-serif;
		overflow-x: clip;
	}
</style>
