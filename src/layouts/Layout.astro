---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content="Track your expenses, set financial goals, and take control of your money with MiCash - your personal finance companion." />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
		<title>MiCash - Personal Finance Made Simple</title>
	</head>
	<body class="bg-bg-dark text-text font-sans antialiased">
		<slot />
	</body>
</html>

<style>
	html, body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		font-family: 'Inter', sans-serif;
		overflow-x: hidden;
	}
</style>
