---
import { siteConfig } from '../config/site';

interface Props {
  translations: any;
}

const { translations } = Astro.props;
---

<section class="cta-section">
  <div class="max-w-7xl mx-auto px-6">
    <div class="cta-panel scroll-animate">
      <span class="cta-mark">B/</span>
      <div>
        <h2><span data-i18n="cta.title">¿Listo para tomar el control de</span> <em data-i18n="cta.titleHighlight">tus finanzas?</em></h2>
        <p data-i18n="cta.description">Descarga Bolsía ahora e inicia tu camino hacia la libertad financiera.</p>
      </div>
      <a href={siteConfig.download.apkUrl} download class="cta-action">
        <span data-i18n="cta.btn">Descargar para Android</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: 7rem 0;
    background: #dff0d9;
    color: #17231d;
  }

  .cta-panel {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: center;
  }

  .cta-mark {
    display: grid;
    width: 5rem;
    height: 5rem;
    place-items: center;
    border-radius: 50%;
    background: #12211b;
    color: #d7f56a;
    font-size: 1.5rem;
    font-weight: 800;
  }

  .cta-panel h2 {
    max-width: 48rem;
    font-size: clamp(2.4rem, 5vw, 5rem);
    font-weight: 800;
    letter-spacing: -0.07em;
    line-height: 0.94;
  }

  .cta-panel h2 em {
    color: #1d7a4c;
    font-style: normal;
  }

  .cta-panel p {
    margin-top: 1rem;
    color: #52635a;
  }

  .cta-action {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: 0.8rem;
    background: #12211b;
    color: #f3faef;
    font-weight: 800;
    white-space: nowrap;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .cta-action:hover {
    transform: translateY(-3px);
    box-shadow: 0 0.75rem 1.5rem rgba(18, 33, 27, 0.18);
  }

  @media (max-width: 800px) {
    .cta-section {
      padding: 5rem 0;
    }

    .cta-panel {
      grid-template-columns: auto 1fr;
    }

    .cta-action {
      grid-column: 2;
      justify-self: start;
    }
  }

  @media (max-width: 480px) {
    .cta-panel {
      grid-template-columns: 1fr;
    }

    .cta-action {
      grid-column: auto;
    }
  }
</style>
