---
interface Props {
  translations: any;
}

const { translations } = Astro.props;
---

<section class="py-24">
  <div class="max-w-5xl mx-auto px-6">
    <div class="text-center mb-16 scroll-animate">
      <span class="inline-block px-4 py-1.5 bg-primary/10 text-primary rounded-full text-sm font-semibold mb-4" data-i18n="howItWorks.label">How It Works</span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold" data-i18n="howItWorks.title">Simple, intuitive, effective</h2>
    </div>
    
    <div class="flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="flex-1 text-center scroll-animate group">
        <div class="step-number-animate w-16 h-16 bg-gradient-to-br from-primary to-primary-dark rounded-2xl flex items-center justify-center text-2xl font-bold mx-auto mb-4 shadow-lg shadow-primary/30 hover:shadow-primary/50 transition-shadow cursor-pointer">1</div>
        <h3 class="text-xl font-bold mb-2 group-hover:text-primary transition-colors" data-i18n="howItWorks.step1.title">Add Your Expense</h3>
        <p class="text-text-muted group-hover:text-text-muted/80 transition-colors" data-i18n="howItWorks.step1.description">Open the app and quickly log what you spent</p>
      </div>
      
      <div class="hidden md:block w-24 h-0.5 bg-gradient-to-r from-primary/50 to-primary/50 relative">
        <div class="absolute right-0 top-1/2 -translate-y-1/2 w-2 h-2 bg-primary rounded-full animate-icon-bounce"></div>
      </div>
      
      <div class="flex-1 text-center scroll-animate delay-100 group">
        <div class="step-number-animate w-16 h-16 bg-gradient-to-br from-primary to-primary-dark rounded-2xl flex items-center justify-center text-2xl font-bold mx-auto mb-4 shadow-lg shadow-primary/30 hover:shadow-primary/50 transition-shadow cursor-pointer">2</div>
        <h3 class="text-xl font-bold mb-2 group-hover:text-primary transition-colors" data-i18n="howItWorks.step2.title">Set Your Goals</h3>
        <p class="text-text-muted group-hover:text-text-muted/80 transition-colors" data-i18n="howItWorks.step2.description">Create savings targets for what matters to you</p>
      </div>
      
      <div class="hidden md:block w-24 h-0.5 bg-gradient-to-r from-primary/50 to-primary/50 relative">
        <div class="absolute right-0 top-1/2 -translate-y-1/2 w-2 h-2 bg-primary rounded-full animate-icon-bounce"></div>
      </div>
      
      <div class="flex-1 text-center scroll-animate delay-200 group">
        <div class="step-number-animate w-16 h-16 bg-gradient-to-br from-primary to-primary-dark rounded-2xl flex items-center justify-center text-2xl font-bold mx-auto mb-4 shadow-lg shadow-primary/30 hover:shadow-primary/50 transition-shadow cursor-pointer">3</div>
        <h3 class="text-xl font-bold mb-2 group-hover:text-primary transition-colors" data-i18n="howItWorks.step3.title">Track Progress</h3>
        <p class="text-text-muted group-hover:text-text-muted/80 transition-colors" data-i18n="howItWorks.step3.description">Watch your spending and savings grow</p>
      </div>
    </div>
  </div>
</section>
