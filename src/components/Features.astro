---
interface Props {
  translations: any;
}

const { translations } = Astro.props;
---

<section id="features" class="py-24 relative">
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-primary/5 to-transparent"></div>
  <div class="max-w-7xl mx-auto px-6 relative">
    <div class="text-center mb-16 scroll-animate">
      <span class="inline-block px-4 py-1.5 bg-primary/10 text-primary rounded-full text-sm font-semibold mb-4" data-i18n="features.label">Features</span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold mb-4">
        <span data-i18n="features.title">Everything you need to</span><br/>
        <span class="bg-gradient-to-r from-primary to-primary-light bg-clip-text text-transparent" data-i18n="features.titleHighlight">manage your money</span>
      </h2>
    </div>
    
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="feature-card-animate group bg-white/3 border border-white/5 rounded-2xl p-6 hover:bg-white/6 hover:border-primary/30 transition-all duration-500 hover:-translate-y-3 scroll-animate magnetic">
        <div class="feature-icon-animate w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-5">
          <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold mb-2 group-hover:text-primary transition-colors" data-i18n="features.quickExpense.title">Quick Expense Tracking</h3>
        <p class="text-text-muted leading-relaxed group-hover:text-text-muted/80 transition-colors" data-i18n="features.quickExpense.description">Add new expenses in seconds from the main screen. No spreadsheets - just tap and go.</p>
      </div>
      
      <div class="feature-card-animate group bg-white/3 border border-white/5 rounded-2xl p-6 hover:bg-white/6 hover:border-primary/30 transition-all duration-500 hover:-translate-y-3 scroll-animate delay-100 magnetic">
        <div class="feature-icon-animate w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-5">
          <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold mb-2 group-hover:text-primary transition-colors" data-i18n="features.history.title">Expense History</h3>
        <p class="text-text-muted leading-relaxed group-hover:text-text-muted/80 transition-colors" data-i18n="features.history.description">View all your transactions in one place. See patterns and understand your spending habits.</p>
      </div>
      
      <div class="feature-card-animate group bg-white/3 border border-white/5 rounded-2xl p-6 hover:bg-white/6 hover:border-primary/30 transition-all duration-500 hover:-translate-y-3 scroll-animate delay-200 magnetic">
        <div class="feature-icon-animate w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-5">
          <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold mb-2 group-hover:text-primary transition-colors" data-i18n="features.goals.title">Goal Setting</h3>
        <p class="text-text-muted leading-relaxed group-hover:text-text-muted/80 transition-colors" data-i18n="features.goals.description">Set savings goals and track your progress. Vacations, phones, emergency funds - we've got you.</p>
      </div>
      
      <div class="feature-card-animate group bg-white/3 border border-white/5 rounded-2xl p-6 hover:bg-white/6 hover:border-primary/30 transition-all duration-500 hover:-translate-y-3 scroll-animate delay-300 magnetic">
        <div class="feature-icon-animate w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-5">
          <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold mb-2 group-hover:text-primary transition-colors" data-i18n="features.settings.title">Personalized Settings</h3>
        <p class="text-text-muted leading-relaxed group-hover:text-text-muted/80 transition-colors" data-i18n="features.settings.description">Update your username, set your monthly budget, and tailor the app to your needs.</p>
      </div>
    </div>
  </div>
</section>
