---
interface Props {
  translations: any;
}

const { translations } = Astro.props;
---

<nav class="fixed top-0 left-0 right-0 z-50 backdrop-blur-xl bg-bg-dark/80 border-b border-white/5">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="#" class="flex items-center gap-3 text-xl font-bold logo-hover">
      <img src="/logo.svg" alt="MiCash" class="w-10 h-10 animate-bounce-subtle" />
      <span class="bg-gradient-to-r from-primary to-primary-light bg-clip-text text-transparent">MiCash</span>
    </a>
    <div class="flex items-center gap-6">
      <a href="#features" class="text-text-muted hover:text-primary transition-colors font-medium hidden sm:block nav-link-animate" data-i18n="nav.features">Features</a>
      <a href="#download" class="text-text-muted hover:text-primary transition-colors font-medium hidden sm:block nav-link-animate" data-i18n="nav.download">Download</a>
      <a href="#how-to-install" class="text-text-muted hover:text-primary transition-colors font-medium hidden sm:block nav-link-animate" data-i18n="nav.installGuide">Install Guide</a>
      
      <div class="flex items-center gap-1 bg-white/5 rounded-lg p-1">
        <button id="lang-en" class="lang-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all" data-lang="en">EN</button>
        <button id="lang-es" class="lang-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all" data-lang="es">ES</button>
      </div>
      
      <a href="#download" class="bg-primary hover:bg-primary-dark text-white px-5 py-2.5 rounded-lg font-semibold text-sm transition-all hover:shadow-lg hover:shadow-primary/25 hover:-translate-y-1 download-btn" data-i18n="nav.getStarted">
        Get Started
      </a>
    </div>
  </div>
</nav>
