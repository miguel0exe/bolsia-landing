---
import { siteConfig } from '../config/site';

interface Props {
  translations: any;
}

const { translations } = Astro.props;
---

<section id="download" class="download-section">
  <div class="max-w-7xl mx-auto px-6">
    <div class="download-panel scroll-animate">
      <div class="download-copy">
        <span class="download-kicker" data-i18n="download.label">Solo Android</span>
        <h2 data-i18n="download.title">Descarga Bolsía</h2>
        <p data-i18n="download.description">Disponible para Android. Descarga el APK y toma el control de tus finanzas hoy.</p>
        <a href={siteConfig.download.apkUrl} download class="download-primary">
          <span data-i18n="download.btn">Descargar APK</span>
          <span aria-hidden="true">↓</span>
        </a>
      </div>

      <div class="download-facts" aria-label="Información de la descarga">
        <div>
          <span class="download-fact-label" data-i18n="download.safe">Seguro y privado</span>
          <strong>100%</strong>
        </div>
        <div>
          <span class="download-fact-label" data-i18n="download.version">Versión {siteConfig.download.version}</span>
          <strong>APK</strong>
        </div>
        <div>
          <span class="download-fact-label" data-i18n="download.size">Tamaño {siteConfig.download.size}</span>
          <strong>Android</strong>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .download-section {
    padding: 7rem 0;
    background: #d7f56a;
    color: #17231d;
  }

  .download-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.65fr);
    gap: 4rem;
    align-items: end;
  }

  .download-kicker {
    color: #1d7a4c;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .download-copy h2 {
    max-width: 42rem;
    margin: 1rem 0;
    font-size: clamp(3rem, 7vw, 6.5rem);
    font-weight: 800;
    letter-spacing: -0.07em;
    line-height: 0.9;
  }

  .download-copy p {
    max-width: 31rem;
    margin-bottom: 2rem;
    color: #52635a;
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .download-primary {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: 0.8rem;
    background: #12211b;
    color: #f3faef;
    font-weight: 800;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .download-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 0.75rem 1.5rem rgba(18, 33, 27, 0.2);
  }

  .download-facts {
    display: grid;
    gap: 1rem;
  }

  .download-facts > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    border-top: 1px solid rgba(23, 35, 29, 0.25);
  }

  .download-fact-label {
    color: #52635a;
    font-size: 0.9rem;
  }

  .download-facts strong {
    color: #1d7a4c;
    font-size: 1.4rem;
  }

  @media (max-width: 700px) {
    .download-section {
      padding: 5rem 0;
    }

    .download-panel {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
