---
import { siteConfig, type HeroVariant } from '../config/site';

interface Props {
  translations: any;
  variant: HeroVariant;
}

const { translations, variant } = Astro.props;
const isLavender = variant === 'lavender';
---

<section class:list={[
  'hero-variant min-h-[calc(100vh-5rem)] flex items-center relative overflow-hidden',
  isLavender ? 'hero-lavender' : 'hero-mint'
]}>
  <div class="hero-grid absolute inset-0 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 py-20 grid lg:grid-cols-2 gap-12 lg:gap-20 items-center relative w-full">
    <div class="space-y-8">
      <div class="hero-eyebrow inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold animate-slide-up">
        <span class="relative flex h-2 w-2">
          <span class="relative inline-flex rounded-full h-2 w-2 hero-dot"></span>
        </span>
        <span data-i18n="hero.badge">App de Finanzas Personales</span>
      </div>

      <h1 class="hero-title text-5xl sm:text-6xl lg:text-8xl font-extrabold leading-[0.94] tracking-[-0.06em] animate-slide-up delay-100">
        <span data-i18n="hero.title">Tus finanzas,</span><br/>
        <em data-i18n="hero.titleHighlight">a tu manera.</em>
      </h1>

      <p class="hero-description text-lg leading-relaxed max-w-xl animate-slide-up delay-200" data-i18n="hero.description">
        Controla tus gastos, establece metas y mantente al tanto de tus finanzas. Bolsía te ayuda a entender a dónde va tu dinero y planificar el futuro.
      </p>

      <div class="flex flex-wrap gap-4 animate-slide-up delay-300">
        <a href="#download" class="hero-primary-action group inline-flex items-center gap-2 px-7 py-4 rounded-xl font-semibold transition-transform duration-300 hover:-translate-y-1">
          <svg class="w-5 h-5 group-hover:animate-icon-bounce" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3 20.5v-17c0-.59.34-1.11.84-1.35L13.69 12l-9.85 9.85c-.5-.25-.84-.76-.84-1.35m13.81-5.38L6.05 21.34l8.49-8.49 2.27 2.27m3.35-4.31c.34.27.59.69.59 1.19s-.22.9-.57 1.18l-2.29 1.32-2.5-2.5 2.5-2.5 2.27 1.31M6.05 2.66l10.76 6.22-2.27 2.27L6.05 2.66"/>
          </svg>
          <span data-i18n="hero.downloadBtn">Download APK</span>
          <svg class="w-4 h-4 transition-transform group-hover:translate-y-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m0 0l-6-6m6 6l6-6"/>
          </svg>
        </a>
        <a href="#features" class="hero-secondary-action group inline-flex items-center gap-2 px-6 py-4 rounded-xl font-semibold transition-colors">
          <span data-i18n="hero.learnMore">Learn More</span>
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <div class="hero-stats flex gap-8 pt-4 animate-slide-up delay-400 number-pop">
        <div class="text-center hover-lift cursor-default p-2 rounded-xl transition-colors">
          <p class="text-2xl font-bold stat-number">100%</p>
          <p class="text-sm text-text-subtle" data-i18n="hero.free">Free</p>
        </div>
        <div class="text-center hover-lift cursor-default p-2 rounded-xl transition-colors">
          <p class="text-2xl font-bold stat-number">$0</p>
          <p class="text-sm text-text-subtle" data-i18n="hero.hiddenFees">Hidden Fees</p>
        </div>
        <div class="text-center hover-lift cursor-default p-2 rounded-xl transition-colors">
          <p class="text-2xl font-bold stat-number">100%</p>
          <p class="text-sm text-text-subtle" data-i18n="hero.private">Private</p>
        </div>
      </div>
    </div>

    <div class="hero-product relative flex justify-center lg:justify-end animate-scale-in delay-200">
      <div class="relative">
        <div class="hero-product-label">Bolsía / Android</div>
        <div class="relative w-64 sm:w-72 mx-auto animate-float">
          <div class="hero-phone rounded-[2.5rem] p-2 transition-all duration-300 phone-hover">
            <div class="flex justify-center py-1">
              <div class="w-3 h-3 bg-black rounded-full"></div>
            </div>

            <div class="overflow-hidden rounded-[1.6rem]" style="height: 430px;">
              <img
                src={siteConfig.assets.heroScreenshot}
                alt="Pantalla principal real de Bolsía"
                class="w-full h-full object-cover object-top"
              />
            </div>

            <div class="flex justify-center py-2">
              <div class="w-24 h-1 bg-white/30 rounded-full"></div>
            </div>
          </div>
          <div class="hero-secondary-shot hero-secondary-shot--analysis">
            <img src={siteConfig.assets.analysisScreenshot} alt="Análisis de gastos de Bolsía" />
            <span>Análisis</span>
          </div>
          <div class="hero-secondary-shot hero-secondary-shot--goals">
            <img src={siteConfig.assets.goalsScreenshot} alt="Metas de ahorro de Bolsía" />
            <span>Ahorro</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-variant {
    --hero-bg: #eff8ed;
    --hero-ink: #17231d;
    --hero-muted: #52635a;
    --hero-accent: #1d7a4c;
    --hero-accent-soft: #d7f56a;
    --hero-border: rgba(23, 35, 29, 0.14);
    background: var(--hero-bg);
    color: var(--hero-ink);
  }

  .hero-lavender {
    --hero-bg: #fcf8f2;
    --hero-ink: #2b2533;
    --hero-muted: #746b79;
    --hero-accent: #6858b8;
    --hero-accent-soft: #c9b9ff;
    --hero-border: rgba(43, 37, 51, 0.14);
  }

  .hero-grid {
    background-image:
      linear-gradient(var(--hero-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--hero-border) 1px, transparent 1px);
    background-position: center;
    background-size: 72px 72px;
    mask-image: linear-gradient(to bottom, black, transparent 72%);
    opacity: 0.35;
  }

  .hero-lavender .hero-grid {
    background-size: 96px 96px;
    transform: rotate(-4deg) scale(1.1);
  }

  .hero-eyebrow {
    border: 1px solid var(--hero-border);
    color: var(--hero-accent);
    background: color-mix(in srgb, var(--hero-accent-soft) 26%, transparent);
  }

  .hero-dot {
    background: var(--hero-accent);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--hero-accent-soft) 65%, transparent);
  }

  .hero-title em {
    color: var(--hero-accent);
    font-style: normal;
  }

  .hero-description {
    color: var(--hero-muted);
  }

  .hero-primary-action {
    color: #fff;
    background: #19241f;
    box-shadow: 8px 8px 0 var(--hero-accent-soft);
  }

  .hero-lavender .hero-primary-action {
    background: var(--hero-accent);
    box-shadow: 8px 8px 0 #b9e2b9;
  }

  .hero-secondary-action {
    color: var(--hero-ink);
    border: 1px solid var(--hero-border);
  }

  .hero-secondary-action:hover {
    background: rgba(255, 255, 255, 0.6);
  }

  .hero-stats {
    color: var(--hero-muted);
  }

  .hero-stats .stat-number {
    color: var(--hero-accent);
  }

  .hero-product::before {
    content: '';
    position: absolute;
    width: 23rem;
    height: 23rem;
    border-radius: 50%;
    background: var(--hero-accent-soft);
    opacity: 0.52;
    transform: translate(1.5rem, 1rem);
  }

  .hero-secondary-shot {
    position: absolute;
    z-index: 2;
    width: 7.5rem;
    padding: 0.35rem;
    border: 0.35rem solid #101413;
    border-radius: 1.25rem;
    background: #101413;
    box-shadow: 10px 12px 0 rgba(23, 35, 29, 0.12);
  }

  .hero-secondary-shot img {
    display: block;
    width: 100%;
    height: 9.5rem;
    object-fit: cover;
    object-position: top;
    border-radius: 0.85rem;
  }

  .hero-secondary-shot span {
    display: block;
    padding-top: 0.35rem;
    color: #f3faef;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  .hero-secondary-shot--analysis {
    left: -6.5rem;
    bottom: 3rem;
    transform: rotate(-8deg);
  }

  .hero-secondary-shot--goals {
    right: -5.5rem;
    top: 1.5rem;
    transform: rotate(7deg);
  }

  .hero-lavender .hero-product::before {
    opacity: 0.72;
    transform: translate(0.75rem, 1.25rem);
  }

  .hero-product-label {
    position: absolute;
    right: -2.5rem;
    top: 3rem;
    z-index: 1;
    color: var(--hero-ink);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }

  .hero-phone {
    background: #101413;
    border: 1px solid rgba(255, 255, 255, 0.32);
    box-shadow: 18px 22px 0 rgba(23, 35, 29, 0.14);
  }

  @media (max-width: 640px) {
    .hero-variant {
      min-height: auto;
    }

    .hero-variant > .max-w-7xl {
      gap: 2.5rem;
      padding-bottom: 3.5rem;
      padding-top: 3.5rem;
    }

    .hero-title {
      font-size: clamp(3.25rem, 17vw, 4.5rem);
    }

    .hero-variant .space-y-8 > :not([hidden]) ~ :not([hidden]) {
      margin-top: 1.25rem;
    }

    .hero-variant .flex-wrap {
      gap: 0.75rem;
    }

    .hero-stats {
      display: none;
    }

    .hero-product {
      margin-top: 1rem;
      margin-bottom: -6rem;
      transform: translateY(-6rem);
    }

    .hero-product::before {
      width: 18rem;
      height: 18rem;
    }

    .hero-product-label {
      right: -1rem;
      top: 2rem;
    }

    .hero-secondary-shot {
      width: 5.5rem;
      border-width: 0.25rem;
      border-radius: 1rem;
    }

    .hero-secondary-shot img {
      height: 7.5rem;
    }

    .hero-secondary-shot--analysis {
      left: -0.5rem;
      bottom: 1rem;
    }

    .hero-secondary-shot--goals {
      right: -0.5rem;
      top: 1rem;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('.hero-variant');
  const requestedVariant = new URLSearchParams(window.location.search).get('variant');

  if (hero && requestedVariant === 'lavender') {
    hero.classList.remove('hero-mint');
    hero.classList.add('hero-lavender');
  }
</script>
