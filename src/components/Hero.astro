---
interface Props {
  translations: any;
}

const { translations } = Astro.props;
---

<section class="min-h-[calc(100vh-5rem)] flex items-center relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-primary/10 via-transparent to-transparent"></div>
  <div class="absolute top-1/4 -left-64 w-96 h-96 bg-primary/20 rounded-full blur-[128px]"></div>
  <div class="absolute bottom-1/4 -right-64 w-96 h-96 bg-primary/10 rounded-full blur-[128px]"></div>
  
  <div class="max-w-7xl mx-auto px-6 py-20 grid lg:grid-cols-2 gap-12 lg:gap-20 items-center relative">
    <div class="space-y-8">
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-primary/10 rounded-full text-primary text-sm font-semibold animate-slide-up hover:bg-primary/20 transition-colors">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
        </span>
        <span data-i18n="hero.badge">Personal Finance App</span>
      </div>
      
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight animate-slide-up delay-100">
        <span data-i18n="hero.title">Your money,</span><br/>
        <span class="bg-gradient-to-r from-primary via-primary-light to-primary-lighter bg-clip-text text-transparent" data-i18n="hero.titleHighlight">your control</span>
      </h1>
      
      <p class="text-lg text-text-muted leading-relaxed max-w-xl animate-slide-up delay-200" data-i18n="hero.description">
        Track expenses, set goals, and stay on top of your finances. Mi Varo helps you understand where your money goes and plan for what's ahead.
      </p>
      
      <div class="flex flex-wrap gap-4 animate-slide-up delay-300">
        <a href="#download" class="group btn-shimmer download-btn inline-flex items-center gap-2 text-white px-6 py-3.5 rounded-xl font-semibold">
          <svg class="w-5 h-5 group-hover:animate-icon-bounce" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3 20.5v-17c0-.59.34-1.11.84-1.35L13.69 12l-9.85 9.85c-.5-.25-.84-.76-.84-1.35m13.81-5.38L6.05 21.34l8.49-8.49 2.27 2.27m3.35-4.31c.34.27.59.69.59 1.19s-.22.9-.57 1.18l-2.29 1.32-2.5-2.5 2.5-2.5 2.27 1.31M6.05 2.66l10.76 6.22-2.27 2.27L6.05 2.66"/>
          </svg>
          <span data-i18n="hero.downloadBtn">Download APK</span>
          <svg class="w-4 h-4 transition-transform group-hover:translate-y-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m0 0l-6-6m6 6l6-6"/>
          </svg>
        </a>
        <a href="#features" class="btn-secondary inline-flex items-center gap-2 bg-white/5 border border-white/10 text-white px-6 py-3.5 rounded-xl font-semibold">
          <span data-i18n="hero.learnMore">Learn More</span>
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
      
      <div class="flex gap-8 pt-4 animate-slide-up delay-400 number-pop">
        <div class="text-center hover-lift cursor-default p-2 rounded-xl transition-colors">
          <p class="text-2xl font-bold text-primary stat-number">100%</p>
          <p class="text-sm text-text-subtle" data-i18n="hero.free">Free</p>
        </div>
        <div class="text-center hover-lift cursor-default p-2 rounded-xl transition-colors">
          <p class="text-2xl font-bold text-primary stat-number">$0</p>
          <p class="text-sm text-text-subtle" data-i18n="hero.hiddenFees">Hidden Fees</p>
        </div>
        <div class="text-center hover-lift cursor-default p-2 rounded-xl transition-colors">
          <p class="text-2xl font-bold text-primary stat-number">100%</p>
          <p class="text-sm text-text-subtle" data-i18n="hero.private">Private</p>
        </div>
      </div>
    </div>
    
    <div class="relative flex justify-center lg:justify-end animate-scale-in delay-200">
      <div class="relative">
        <div class="absolute -inset-4 bg-primary/20 rounded-[3rem] blur-3xl opacity-50 animate-pulse"></div>
        
        <div class="relative w-64 sm:w-72 mx-auto animate-float">
          <div class="bg-[#121212] rounded-[2.5rem] p-2 shadow-2xl shadow-black/50 border border-white/10 hover:border-primary/30 transition-all duration-500 phone-hover">
            <div class="flex justify-center py-1">
              <div class="w-3 h-3 bg-black rounded-full"></div>
            </div>
            
            <div class="overflow-hidden rounded-[1.6rem]" style="height: 430px; background-color: #121212;">
              <img 
                src="/Principal.jpg" 
                alt="Mi Varo Main Screen" 
                class="w-full h-full object-cover object-top"
              />
            </div>
            
            <div class="flex justify-center py-2">
              <div class="w-24 h-1 bg-white/30 rounded-full"></div>
            </div>
          </div>
        </div>
        
        <div class="absolute -bottom-8 -right-4 sm:right-0 w-48 sm:w-52 opacity-90 hover:opacity-100 hover:scale-105 transition-all duration-500 cursor-pointer z-20 group">
          <div class="bg-[#121212] rounded-[2rem] p-1.5 shadow-2xl shadow-black/50 border border-white/10">
            <div class="flex justify-center py-0.5">
              <div class="w-2.5 h-2.5 bg-black rounded-full"></div>
            </div>
            
            <div class="overflow-hidden rounded-[1.4rem]" style="height: 350px; background-color: #121212;">
              <img 
                src="/Historial.jpg" 
                alt="Mi Varo History Screen" 
                class="w-full h-full object-cover"
              />
            </div>
            
            <div class="flex justify-center py-1.5">
              <div class="w-16 h-0.75 bg-white/30 rounded-full"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
